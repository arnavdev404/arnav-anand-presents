# =============================================================
# ARNAV ANAND PRESENTS — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local with real secrets to version control.
# =============================================================

# Cloudinary Configuration (Server-Side Only — NEVER expose to browser)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Configuration
# Safe for browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only:
SUPABASE_SERVICE_ROLE_KEY=

# Admin Authorization
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Site URL (for metadata & canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
